{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "json.schemaDownload.trustedDomains": {
        "https://ui.shadcn.com/schema.json": true
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.removeUnusedImports": "explicit",
        "source.fixAll.eslint": "explicit"
    },
    "cSpell.words": [
        "Academind",
        "aheadvision",
        "Bootcamp",
        "cakephp",
        "CGPA",
        "crossfade",
        "crossfades",
        "cypressio",
        "deadzone",
        "devicon",
        "Devicons",
        "Embla",
        "Ezki",
        "fastapi",
        "githubactions",
        "Hakyda",
        "highp",
        "interruptible",
        "Kalob",
        "Laravel",
        "luma",
        "Moodboard",
        "Nasional",
        "pressable",
        "Qalb",
        "Radek",
        "Rejebov",
        "résumé",
        "Schwarzmüller",
        "socketio",
        "Spoonacular",
        "tasbih",
        "Taulien",
        "Tenaga",
        "Tyrell",
        "Udemy",
        "UNITEN",
        "Universiti",
        "Wilk",
        "webglcontextlost",
        "Yusup",
        "yusuprd",
        "yuzee",
        "Yuzee",
        "zakat"
    ],
    "cSpell.ignorePaths": ["node_modules", "dist", "package-lock.json", ".git"]
}
